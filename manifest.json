{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Esp32 Live Stats Viewer",
    "author": "Ichika",
    "version": "1.0.0",
    "minimum-overwolf-version": "0.170.0",
    "description": "Live Stats Viewer for Esp32",
    "icon": "icons/IconMouseOver.png",
    "icon_gray": "icons/IconMouseNormal.png",
    "launcher_icon": "icons/desktop-icon.ico",
    "window_icon": "icons/IconMouseOver.png"
  },
  "permissions": [
    "Hotkeys",
    "GameInfo",
    "Clipboard",
    "DesktopStreaming"
  ],
  "data": {
    "start_window": "background",
    "protocol_override_domains": {
      "googlesyndication": "http"
    },
    "externally_connectable": {
      "matches": [
        "http://*.overwolf.com",
        "https://*.overwolf.com"
      ]
    },
    "force_browser": "user",
    "windows": {
      "background": {
        "file": "windows/background/background.html",
        "background_optimization": true,
        "is_background_page": true
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [
        21640
      ]
    },
    "game_events": [
      21640
    ],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [
            21640
          ]
        },
        "start_minimized": true
      }
    ],
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}
